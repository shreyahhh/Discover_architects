# Backend environment variables. Copy to backend/.env (gitignored) and fill
# in real values from your Supabase project settings. Never commit backend/.env.

PORT=5000

# Public URL the frontend is served from, used to build redirect URLs.
APP_URL=http://localhost:3000

# Supabase project settings -> API. SUPABASE_SERVICE_ROLE_KEY bypasses Row
# Level Security — it must only ever be used server-side (here), never
# shipped to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# PhonePe payment gateway. The defaults below are PhonePe's own publicly
# documented UAT sandbox test credentials (safe to keep for local dev).
# Replace with your real merchant credentials before going to production,
# and never commit production values.
PHONEPE_MERCHANT_ID=PGTESTPAYUAT
PHONEPE_SALT_KEY=099eb0cd-02cf-4e2a-8aca-3e6c6aff0399
PHONEPE_SALT_INDEX=1

# Set to "true" only if you need to bypass TLS verification for a local
# self-signed proxy. Never set this in production.
DEV_DISABLE_TLS_VERIFY=false
