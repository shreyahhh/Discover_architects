# Frontend (Create React App) environment variables.
# Copy this file to .env.local (gitignored) and fill in real values.
# Only REACT_APP_* variables are exposed to the browser bundle — never put
# a service-role or other secret key here.

# Base URL of the Express API (backend/server.ts).
REACT_APP_API_URL=http://localhost:5000

# These are currently unused by the app (src/config/supabase.ts is dormant —
# the frontend talks to Supabase only through the Express backend). Kept here
# in case a future pass wires the browser client up directly.
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=
